{
  "name": "proiect-web1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "db:up": "docker compose up -d --wait db",
